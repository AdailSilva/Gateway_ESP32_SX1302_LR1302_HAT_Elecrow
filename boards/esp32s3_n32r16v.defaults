# ---------------------------------------------------------------------------
# Board: ESP32-S3-WROOM-2-N32R16V DevKit (DevKitC-1, 2 x 22 pins)
#        BOARD=esp32s3_n32r16v   IDF_TARGET=esp32s3
#        (shield marking "MCN32R16V"; old build name: esp32s3)
#
#   Chip    ESP32-S3R16V, Xtensa LX7 dual-core 240 MHz, 512 KB SRAM
#   Flash   32 MB OCTAL SPI, 1.8 V              (N32)
#   PSRAM   16 MB OCTAL SPI, 1.8 V, GPIO33-37   (R16V)
#   Antenna PCB only (no u.FL)
#   Console native USB (USB-Serial/JTAG, GPIO19/20) -> /dev/ttyACM0
#           (set in sdkconfig.defaults.esp32s3)
#
# VDD_SPI is 1.8 V on this module: GPIO47/48 work at 1.8 V, never wire 3.3 V
# signals to them. Without the octal options below the module does not boot.
#
# Loaded after sdkconfig.defaults and sdkconfig.defaults.esp32s3 (see CMakeLists.txt).
# Pin map: main/CMakeLists.txt. Guide: doc/hardware/ESP32-S3-WROOM-2_N32R16V_DevKit.md
# ---------------------------------------------------------------------------
CONFIG_GW_BOARD_ESP32S3_WROOM_2_N32R16V=y

# Flash: 32 MB octal (OPI), 80 MHz
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# PSRAM: 16 MB octal, 80 MHz, added to the heap (malloc may return PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
